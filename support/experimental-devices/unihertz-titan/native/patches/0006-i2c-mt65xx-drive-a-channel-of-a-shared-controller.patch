Subject: [PATCH] i2c: mt65xx: drive a channel of a shared controller

The MT6771's I2C controller at 0x11008000 is shared with the camera control
unit. MediaTek's kernel resets it through channel 0, with its interrupts
masked there, then drives it through the channel at ch_offset_default,
0x100, whose copy of the registers below 0x100 it programs. On that channel
it clears the multi-channel FIFO address, takes a missing acknowledgement
from the status when the transfer completes and then resets nothing, routes
the channel's interrupt to the CPU, and after a timeout or an incomplete
transfer resets through channel 0 and hands the bus back to the arbiter.
Driven as one channel at offset 0, every transfer stalled without an
interrupt (native-i2c-input-scan-trial.adoc). Do the same for a node with
the property mediatek,channel-offset, 0x100 or 0x200, on controllers with
the MT8183 register layout, and warn with the channel's start and status on
a timeout there; without the property nothing changes.
---
--- a/drivers/i2c/busses/i2c-mt65xx.c
+++ b/drivers/i2c/busses/i2c-mt65xx.c
@@ -41,6 +41,7 @@
 #define I2C_SOFT_RST			0x0001
 #define I2C_HANDSHAKE_RST		0x0020
 #define I2C_FIFO_ADDR_CLR		0x0001
+#define I2C_FIFO_ADDR_CLR_MCH		0x0004
 #define I2C_DELAY_LEN			0x0002
 #define I2C_ST_START_CON		0x8001
 #define I2C_FS_START_CON		0x1800
@@ -52,6 +53,9 @@
 #define I2C_CHN_CLR_FLAG		0x0000
 #define I2C_RELIABILITY		0x0010
 #define I2C_DMAACK_ENABLE		0x0008
+#define I2C_RESUME_ARBIT		(1 << 1)
+#define I2C_MCU_INTR_EN			0x0001
+#define I2C_CHANNEL_WINDOW		0x100
 
 #define I2C_DMA_CON_TX			0x0000
 #define I2C_DMA_CON_RX			0x0001
@@ -165,6 +169,7 @@
 	OFFSET_STA_STO_AC_TIMING,
 	OFFSET_HS_STA_STO_AC_TIMING,
 	OFFSET_SDA_TIMING,
+	OFFSET_MCU_INTR,
 };
 
 static const u16 mt_i2c_regs_v1[] = {
@@ -217,6 +222,7 @@
 	[OFFSET_IO_CONFIG] = 0x34,
 	[OFFSET_FIFO_ADDR_CLR] = 0x38,
 	[OFFSET_SDA_TIMING] = 0x3c,
+	[OFFSET_MCU_INTR] = 0x40,
 	[OFFSET_TRANSFER_LEN_AUX] = 0x44,
 	[OFFSET_CLOCK_DIV] = 0x48,
 	[OFFSET_SOFTRESET] = 0x50,
@@ -297,6 +303,7 @@
 	struct clk_bulk_data clocks[I2C_MT65XX_CLK_MAX]; /* clocks for i2c */
 	bool have_pmic;			/* can use i2c pins from PMIC */
 	bool use_push_pull;		/* IO config push-pull mode */
+	u16 ch_offset;			/* channel of a shared controller, or 0 */
 
 	u16 irq_stat;			/* interrupt status */
 	unsigned int clk_src_div;
@@ -540,26 +547,60 @@
 };
 MODULE_DEVICE_TABLE(of, mtk_i2c_of_match);
 
+/*
+ * Each channel of a shared controller has its own copy of the registers
+ * below I2C_CHANNEL_WINDOW; the rest are the controller's. Channel 0 is
+ * where MediaTek's kernel resets such a controller.
+ */
+static void __iomem *mtk_i2c_reg(struct mtk_i2c *i2c, u16 ch,
+				 enum I2C_REGS_OFFSET reg)
+{
+	u16 offset = i2c->dev_comp->regs[reg];
+
+	if (offset < I2C_CHANNEL_WINDOW)
+		offset += ch;
+	return i2c->base + offset;
+}
+
+static u16 mtk_i2c_ch_readw(struct mtk_i2c *i2c, u16 ch,
+			    enum I2C_REGS_OFFSET reg)
+{
+	return readw(mtk_i2c_reg(i2c, ch, reg));
+}
+
+static void mtk_i2c_ch_writew(struct mtk_i2c *i2c, u16 ch, u16 val,
+			      enum I2C_REGS_OFFSET reg)
+{
+	writew(val, mtk_i2c_reg(i2c, ch, reg));
+}
+
 static u16 mtk_i2c_readw(struct mtk_i2c *i2c, enum I2C_REGS_OFFSET reg)
 {
-	return readw(i2c->base + i2c->dev_comp->regs[reg]);
+	return mtk_i2c_ch_readw(i2c, i2c->ch_offset, reg);
 }
 
 static void mtk_i2c_writew(struct mtk_i2c *i2c, u16 val,
 			   enum I2C_REGS_OFFSET reg)
 {
-	writew(val, i2c->base + i2c->dev_comp->regs[reg]);
+	mtk_i2c_ch_writew(i2c, i2c->ch_offset, val, reg);
 }
 
+static void mtk_i2c_config_hw(struct mtk_i2c *i2c, u16 ch);
+
 static void mtk_i2c_init_hw(struct mtk_i2c *i2c)
 {
-	u16 control_reg;
 	u16 intr_stat_reg;
-	u16 ext_conf_val;
 
-	mtk_i2c_writew(i2c, I2C_CHN_CLR_FLAG, OFFSET_START);
-	intr_stat_reg = mtk_i2c_readw(i2c, OFFSET_INTR_STAT);
-	mtk_i2c_writew(i2c, intr_stat_reg, OFFSET_INTR_STAT);
+	/*
+	 * MediaTek's kernel resets a shared controller through channel 0, with
+	 * its interrupts masked there, and then programs the registers of the
+	 * channel it uses.
+	 */
+	if (i2c->ch_offset)
+		mtk_i2c_ch_writew(i2c, 0, 0, OFFSET_INTR_MASK);
+	mtk_i2c_ch_writew(i2c, 0, I2C_CHN_CLR_FLAG, OFFSET_START);
+	intr_stat_reg = mtk_i2c_ch_readw(i2c, 0, OFFSET_INTR_STAT);
+	mtk_i2c_ch_writew(i2c, 0, intr_stat_reg, OFFSET_INTR_STAT);
 
 	if (i2c->dev_comp->apdma_sync) {
 		writel(I2C_DMA_WARM_RST, i2c->pdmabase + OFFSET_RST);
@@ -568,31 +609,44 @@
 		udelay(10);
 		writel(I2C_DMA_HANDSHAKE_RST | I2C_DMA_HARD_RST,
 		       i2c->pdmabase + OFFSET_RST);
-		mtk_i2c_writew(i2c, I2C_HANDSHAKE_RST | I2C_SOFT_RST,
-			       OFFSET_SOFTRESET);
+		mtk_i2c_ch_writew(i2c, 0, I2C_HANDSHAKE_RST | I2C_SOFT_RST,
+				  OFFSET_SOFTRESET);
 		udelay(10);
 		writel(I2C_DMA_CLR_FLAG, i2c->pdmabase + OFFSET_RST);
-		mtk_i2c_writew(i2c, I2C_CHN_CLR_FLAG, OFFSET_SOFTRESET);
+		mtk_i2c_ch_writew(i2c, 0, I2C_CHN_CLR_FLAG, OFFSET_SOFTRESET);
 	} else {
 		writel(I2C_DMA_HARD_RST, i2c->pdmabase + OFFSET_RST);
 		udelay(50);
 		writel(I2C_DMA_CLR_FLAG, i2c->pdmabase + OFFSET_RST);
-		mtk_i2c_writew(i2c, I2C_SOFT_RST, OFFSET_SOFTRESET);
+		mtk_i2c_ch_writew(i2c, 0, I2C_SOFT_RST, OFFSET_SOFTRESET);
 	}
 
+	mtk_i2c_config_hw(i2c, 0);
+	if (i2c->ch_offset) {
+		intr_stat_reg = mtk_i2c_readw(i2c, OFFSET_INTR_STAT);
+		mtk_i2c_writew(i2c, intr_stat_reg, OFFSET_INTR_STAT);
+		mtk_i2c_config_hw(i2c, i2c->ch_offset);
+	}
+}
+
+static void mtk_i2c_config_hw(struct mtk_i2c *i2c, u16 ch)
+{
+	u16 control_reg;
+	u16 ext_conf_val;
+
 	/* Set ioconfig */
 	if (i2c->use_push_pull)
-		mtk_i2c_writew(i2c, I2C_IO_CONFIG_PUSH_PULL, OFFSET_IO_CONFIG);
+		mtk_i2c_ch_writew(i2c, ch, I2C_IO_CONFIG_PUSH_PULL, OFFSET_IO_CONFIG);
 	else
-		mtk_i2c_writew(i2c, I2C_IO_CONFIG_OPEN_DRAIN, OFFSET_IO_CONFIG);
+		mtk_i2c_ch_writew(i2c, ch, I2C_IO_CONFIG_OPEN_DRAIN, OFFSET_IO_CONFIG);
 
 	if (i2c->dev_comp->dcm)
-		mtk_i2c_writew(i2c, I2C_DCM_DISABLE, OFFSET_DCM_EN);
+		mtk_i2c_ch_writew(i2c, ch, I2C_DCM_DISABLE, OFFSET_DCM_EN);
 
-	mtk_i2c_writew(i2c, i2c->timing_reg, OFFSET_TIMING);
-	mtk_i2c_writew(i2c, i2c->high_speed_reg, OFFSET_HS);
+	mtk_i2c_ch_writew(i2c, ch, i2c->timing_reg, OFFSET_TIMING);
+	mtk_i2c_ch_writew(i2c, ch, i2c->high_speed_reg, OFFSET_HS);
 	if (i2c->dev_comp->ltiming_adjust)
-		mtk_i2c_writew(i2c, i2c->ltiming_reg, OFFSET_LTIMING);
+		mtk_i2c_ch_writew(i2c, ch, i2c->ltiming_reg, OFFSET_LTIMING);
 
 	if (i2c->speed_hz <= I2C_MAX_STANDARD_MODE_FREQ)
 		ext_conf_val = I2C_ST_START_CON;
@@ -601,43 +655,43 @@
 
 	if (i2c->dev_comp->timing_adjust) {
 		ext_conf_val = i2c->ac_timing.ext;
-		mtk_i2c_writew(i2c, i2c->ac_timing.inter_clk_div,
+		mtk_i2c_ch_writew(i2c, ch, i2c->ac_timing.inter_clk_div,
 			       OFFSET_CLOCK_DIV);
-		mtk_i2c_writew(i2c, I2C_SCL_MIS_COMP_VALUE,
+		mtk_i2c_ch_writew(i2c, ch, I2C_SCL_MIS_COMP_VALUE,
 			       OFFSET_SCL_MIS_COMP_POINT);
-		mtk_i2c_writew(i2c, i2c->ac_timing.sda_timing,
+		mtk_i2c_ch_writew(i2c, ch, i2c->ac_timing.sda_timing,
 			       OFFSET_SDA_TIMING);
 
 		if (i2c->dev_comp->ltiming_adjust) {
-			mtk_i2c_writew(i2c, i2c->ac_timing.htiming,
+			mtk_i2c_ch_writew(i2c, ch, i2c->ac_timing.htiming,
 				       OFFSET_TIMING);
-			mtk_i2c_writew(i2c, i2c->ac_timing.hs, OFFSET_HS);
-			mtk_i2c_writew(i2c, i2c->ac_timing.ltiming,
+			mtk_i2c_ch_writew(i2c, ch, i2c->ac_timing.hs, OFFSET_HS);
+			mtk_i2c_ch_writew(i2c, ch, i2c->ac_timing.ltiming,
 				       OFFSET_LTIMING);
 		} else {
-			mtk_i2c_writew(i2c, i2c->ac_timing.scl_hl_ratio,
+			mtk_i2c_ch_writew(i2c, ch, i2c->ac_timing.scl_hl_ratio,
 				       OFFSET_SCL_HIGH_LOW_RATIO);
-			mtk_i2c_writew(i2c, i2c->ac_timing.hs_scl_hl_ratio,
+			mtk_i2c_ch_writew(i2c, ch, i2c->ac_timing.hs_scl_hl_ratio,
 				       OFFSET_HS_SCL_HIGH_LOW_RATIO);
-			mtk_i2c_writew(i2c, i2c->ac_timing.sta_stop,
+			mtk_i2c_ch_writew(i2c, ch, i2c->ac_timing.sta_stop,
 				       OFFSET_STA_STO_AC_TIMING);
-			mtk_i2c_writew(i2c, i2c->ac_timing.hs_sta_stop,
+			mtk_i2c_ch_writew(i2c, ch, i2c->ac_timing.hs_sta_stop,
 				       OFFSET_HS_STA_STO_AC_TIMING);
 		}
 	}
-	mtk_i2c_writew(i2c, ext_conf_val, OFFSET_EXT_CONF);
+	mtk_i2c_ch_writew(i2c, ch, ext_conf_val, OFFSET_EXT_CONF);
 
 	/* If use i2c pin from PMIC mt6397 side, need set PATH_DIR first */
 	if (i2c->have_pmic)
-		mtk_i2c_writew(i2c, I2C_CONTROL_WRAPPER, OFFSET_PATH_DIR);
+		mtk_i2c_ch_writew(i2c, ch, I2C_CONTROL_WRAPPER, OFFSET_PATH_DIR);
 
 	control_reg = I2C_CONTROL_ACKERR_DET_EN |
 		      I2C_CONTROL_CLK_EXT_EN | I2C_CONTROL_DMA_EN;
 	if (i2c->dev_comp->dma_sync)
 		control_reg |= I2C_CONTROL_DMAACK_EN | I2C_CONTROL_ASYNC_MODE;
 
-	mtk_i2c_writew(i2c, control_reg, OFFSET_CONTROL);
-	mtk_i2c_writew(i2c, I2C_DELAY_LEN, OFFSET_DELAY_LEN);
+	mtk_i2c_ch_writew(i2c, ch, control_reg, OFFSET_CONTROL);
+	mtk_i2c_ch_writew(i2c, ch, I2C_DELAY_LEN, OFFSET_DELAY_LEN);
 }
 
 static const struct i2c_spec_values *mtk_i2c_get_spec(unsigned int speed)
@@ -999,6 +1053,7 @@
 	u16 addr_reg;
 	u16 start_reg;
 	u16 control_reg;
+	u16 intr_mask;
 	u16 restart_flag = 0;
 	u16 dma_sync = 0;
 	u32 reg_4g_mode;
@@ -1055,11 +1110,23 @@
 	mtk_i2c_writew(i2c, restart_flag | I2C_HS_NACKERR | I2C_ACKERR |
 			    I2C_ARB_LOST | I2C_TRANSAC_COMP, OFFSET_INTR_STAT);
 
-	mtk_i2c_writew(i2c, I2C_FIFO_ADDR_CLR, OFFSET_FIFO_ADDR_CLR);
+	/*
+	 * On a channel of a shared controller MediaTek's kernel also clears
+	 * the multi-channel FIFO address and takes a missing acknowledgement
+	 * from the status only, when the transfer completes.
+	 */
+	intr_mask = restart_flag | I2C_HS_NACKERR | I2C_ACKERR |
+		    I2C_ARB_LOST | I2C_TRANSAC_COMP;
+	if (i2c->ch_offset) {
+		mtk_i2c_writew(i2c, I2C_FIFO_ADDR_CLR_MCH | I2C_FIFO_ADDR_CLR,
+			       OFFSET_FIFO_ADDR_CLR);
+		intr_mask &= ~(I2C_HS_NACKERR | I2C_ACKERR);
+	} else {
+		mtk_i2c_writew(i2c, I2C_FIFO_ADDR_CLR, OFFSET_FIFO_ADDR_CLR);
+	}
 
 	/* Enable interrupt */
-	mtk_i2c_writew(i2c, restart_flag | I2C_HS_NACKERR | I2C_ACKERR |
-			    I2C_ARB_LOST | I2C_TRANSAC_COMP, OFFSET_INTR_MASK);
+	mtk_i2c_writew(i2c, intr_mask, OFFSET_INTR_MASK);
 
 	/* Set transfer and transaction len */
 	if (i2c->op == I2C_MASTER_WRRD) {
@@ -1192,6 +1259,9 @@
 		if (left_num >= 1)
 			start_reg |= I2C_RS_MUL_CNFG;
 	}
+	/* MediaTek's kernel routes a channel's interrupt to the CPU. */
+	if (i2c->ch_offset)
+		mtk_i2c_writew(i2c, I2C_MCU_INTR_EN, OFFSET_MCU_INTR);
 	mtk_i2c_writew(i2c, start_reg, OFFSET_START);
 
 	ret = wait_for_completion_timeout(&i2c->msg_complete,
@@ -1224,12 +1294,37 @@
 	if (ret == 0) {
 		dev_dbg(i2c->dev, "addr: %x, transfer timeout\n", msgs->addr);
 		i2c_dump_register(i2c);
+		if (i2c->ch_offset) {
+			start_reg = mtk_i2c_readw(i2c, OFFSET_START);
+			dev_warn(i2c->dev,
+				 "channel 0x%x: addr %x timed out, start 0x%x, status 0x%x\n",
+				 i2c->ch_offset, msgs->addr, start_reg,
+				 mtk_i2c_readw(i2c, OFFSET_INTR_STAT));
+		}
 		mtk_i2c_init_hw(i2c);
+		/* MediaTek's kernel then hands the bus back to the arbiter. */
+		if (i2c->ch_offset && (start_reg & I2C_RESUME_ARBIT))
+			mtk_i2c_ch_writew(i2c, 0, I2C_RESUME_ARBIT, OFFSET_START);
 		return -ETIMEDOUT;
 	}
 
 	if (i2c->irq_stat & (I2C_HS_NACKERR | I2C_ACKERR)) {
 		dev_dbg(i2c->dev, "addr: %x, transfer ACK error\n", msgs->addr);
+		if (i2c->ch_offset) {
+			/*
+			 * On a channel MediaTek's kernel clears the FIFO address
+			 * and, if the transfer completed, nothing more; else it
+			 * resets and hands the bus back to the arbiter.
+			 */
+			mtk_i2c_writew(i2c, I2C_FIFO_ADDR_CLR_MCH |
+					    I2C_FIFO_ADDR_CLR,
+				       OFFSET_FIFO_ADDR_CLR);
+			if (i2c->irq_stat & I2C_TRANSAC_COMP)
+				return -ENXIO;
+			mtk_i2c_init_hw(i2c);
+			mtk_i2c_ch_writew(i2c, 0, I2C_RESUME_ARBIT, OFFSET_START);
+			return -ENXIO;
+		}
 		mtk_i2c_init_hw(i2c);
 		return -ENXIO;
 	}
@@ -1360,6 +1455,7 @@
 
 static int mtk_i2c_parse_dt(struct device_node *np, struct mtk_i2c *i2c)
 {
+	u32 ch_offset;
 	int ret;
 
 	ret = of_property_read_u32(np, "clock-frequency", &i2c->speed_hz);
@@ -1376,6 +1472,19 @@
 	i2c->have_pmic = of_property_read_bool(np, "mediatek,have-pmic");
 	i2c->use_push_pull =
 		of_property_read_bool(np, "mediatek,use-push-pull");
+
+	/*
+	 * A controller shared with a coprocessor, such as the MT6771's camera
+	 * control unit, is driven through one of its channels, as MediaTek's
+	 * kernel does with its ch_offset_default.
+	 */
+	if (!of_property_read_u32(np, "mediatek,channel-offset", &ch_offset)) {
+		if (i2c->dev_comp->regs != mt_i2c_regs_v2 ||
+		    (ch_offset != 0x100 && ch_offset != 0x200))
+			return -EINVAL;
+		i2c->ch_offset = ch_offset;
+		dev_info(i2c->dev, "driven through channel 0x%x\n", ch_offset);
+	}
 
 	i2c_parse_fw_timings(i2c->dev, &i2c->timing_info, true);
 
